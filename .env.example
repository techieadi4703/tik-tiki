# Tiktiki Environment Variables Template (v1.0)
# DO NOT COMMIT LIVE SECRETS TO GIT

# Server Environment
PORT=8080
ENV=development # development | staging | production
API_BASE_URL=http://localhost:8080/v1
WEB_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16 with PostGIS)
DATABASE_URL=postgresql://tiktiki_admin:local_secret_pass@localhost:5432/tiktiki_dev?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Redis Cache & Background Queue
REDIS_URL=redis://localhost:6379/0

# External Travel Data Providers (Phase 1)
DUFFEL_API_KEY=duffel_test_xxxxxxxxxxxxxxxxxxxx
AMADEUS_API_KEY=xxxxxxxxxxxxxxxxxxxx
AMADEUS_API_SECRET=xxxxxxxxxxxxxxxxxxxx
RAPIDAPI_RAIL_KEY=xxxxxxxxxxxxxxxxxxxx

# Messaging & Alerts Delivery (Gupshup / MSG91 / Resend)
WHATSAPP_API_KEY=xxxxxxxxxxxxxxxxxxxx
WHATSAPP_SENDER_PHONE=+919876543210
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FCM_SERVER_KEY=xxxxxxxxxxxxxxxxxxxx

# Observability & Analytics
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxx
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxx
